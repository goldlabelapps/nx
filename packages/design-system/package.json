{
  "name": "@nx/design-system",
  "version": "3.0.3",
  "description": "Shared frontend presentation package for NX\u00b0, covering theme, layout, and reusable UI primitives.",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./styles.css": {
      "import": "./dist/styles/globals.css",
      "require": "./dist/styles/globals.css",
      "default": "./dist/styles/globals.css"
    },
    "./site-layout.css": {
      "import": "./dist/styles/site-layout.css",
      "require": "./dist/styles/site-layout.css",
      "default": "./dist/styles/site-layout.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/styles && cp src/styles/*.css dist/styles/",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "echo 'No lint configured yet'",
    "clean": "rm -rf dist",
    "storybook:clean-cache": "rm -rf ../../node_modules/.cache/storybook node_modules/.cache/storybook",
    "dev": "pnpm run storybook",
    "storybook": "pnpm run storybook:clean-cache && storybook dev -p 6006",
    "storybook:ci": "pnpm run storybook:clean-cache && storybook dev -p 6006 --ci",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@mui/icons-material": ">=7.0.0",
    "@mui/material": ">=7.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.2",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/react-vite": "^10.5.6",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-share": "^5.3.0",
    "storybook": "^10.5.6",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "@storybook/addon-mcp": "^0.7.0"
  }
}
