{
  "name": "@leida/design-system",
  "version": "1.0.0",
  "description": "Leida Design System: tokens, components, guidelines, and templates",
  "private": false,
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./styles": "./styles.css",
    "./tokens": {
      "types": "./tokens.d.ts",
      "import": "./tokens.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "tokens.js",
    "tokens.d.ts",
    "dist",
    "styles.css",
    "assets",
    "components",
    "guidelines",
    "tokens",
    "templates",
    "ui_kits"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "echo 'No lint configured yet'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/react": "^10.5.2",
    "@storybook/react-vite": "^10.5.2",
    "storybook": "^10.5.2",
    "typescript": "^5.0.0"
  }
}
