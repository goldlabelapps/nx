{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "ignoreDeprecations": "5.0",
    "declaration": true,
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "module": "ESNext",
    "target": "ES2020",
    "isolatedModules": false,
    "jsx": "react-jsx",
    "rootDir": "src",
    "paths": {},
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts", "**/*.test.tsx", "**/*.spec.tsx"]
}
