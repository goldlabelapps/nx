{
  "name": "@goldlabelapps/theme",
  "version": "3.2.7",
  "description": "NX° theme tokens, UI primitives, and layout showcase blocks",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./styles.css": {
      "import": "./dist/styles/globals.css",
      "require": "./dist/styles/globals.css",
      "default": "./dist/styles/globals.css"
    },
    "./globals.css": {
      "import": "./dist/styles/globals.css",
      "require": "./dist/styles/globals.css",
      "default": "./dist/styles/globals.css"
    },
    "./site-layout.css": {
      "import": "./dist/styles/site-layout.css",
      "require": "./dist/styles/site-layout.css",
      "default": "./dist/styles/site-layout.css"
    },
    "./tokens.css": {
      "import": "./dist/styles/tokens.css",
      "require": "./dist/styles/tokens.css",
      "default": "./dist/styles/tokens.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --dir ../flash build && tsc -p tsconfig.build.json && mkdir -p dist/styles && cp src/styles/*.css dist/styles/",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@mui/icons-material": ">=7.0.0",
    "@mui/material": ">=7.0.0",
    "next": ">=15.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "react-share": "^5.3.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.2",
    "@testing-library/react": "^16.3.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^26.1.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
