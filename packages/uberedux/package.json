{
  "name": "@goldlabelapps/uberedux",
  "version": "3.2.7",
  "description": "Shared Redux store/provider/hooks used across NX apps.",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js",
      "require": "./dist/store.js"
    },
    "./UbereduxProvider": {
      "types": "./dist/UbereduxProvider.d.ts",
      "import": "./dist/UbereduxProvider.js",
      "require": "./dist/UbereduxProvider.js"
    },
    "./hooks/useDispatch": {
      "types": "./dist/hooks/useDispatch.d.ts",
      "import": "./dist/hooks/useDispatch.js",
      "require": "./dist/hooks/useDispatch.js"
    },
    "./hooks/useSlice": {
      "types": "./dist/hooks/useSlice.d.ts",
      "import": "./dist/hooks/useSlice.js",
      "require": "./dist/hooks/useSlice.js"
    },
    "./themePreferenceStore": {
      "types": "./dist/themePreferenceStore.d.ts",
      "import": "./dist/themePreferenceStore.js",
      "require": "./dist/themePreferenceStore.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test tests/**/*.test.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@reduxjs/toolkit": ">=2.0.0",
    "react": ">=18.0.0",
    "react-redux": ">=8.0.0",
    "redux": ">=4.0.0",
    "redux-persist": ">=6.0.0"
  },
  "dependencies": {
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "19.2.8",
    "react-redux": "^9",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
