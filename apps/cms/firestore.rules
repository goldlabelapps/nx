rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isPublished(data) {
      return data.status == 'published';
    }

    match /fingerprints/{document=**} {
      // This is bad, mmmkay?
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /virus/{document=**} {
      // This is bad, mmmkay?
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /tenants/{document=**} {
      // Anyone can read
      allow read: if true;
      // Anyone can create
      allow create: if true;
      // Only authenticated users can update/delete
      allow update, delete: if request.auth != null;
    }


    match /prospectCategories/{document=**} {
      // Anyone can read
      allow read: if true;
      // Anyone can create
      allow create: if true;
      // Only authenticated users can update/delete
      allow update, delete: if request.auth != null;
    }

    match /prospects/{document=**} {
      // Anyone can read
      allow read: if true;
      // Anyone can create
      allow create: if true;
      // Only authenticated users can update/delete
      allow update, delete: if request.auth != null;
    }

    match /viruses/{document=**} {
      // Anyone can read
      allow read: if true;
      // Anyone can create
      allow create: if true;
      // Only authenticated users can update/delete
      allow update, delete: if request.auth != null;
    }

    match /accounts/{document=**} {
      // Anyone can read
      allow read: if true;
      // Anyone can create
      allow create: if true;
      // Only authenticated users can update/delete
      allow update, delete: if request.auth != null;
    }

    // Posts: public can read published posts, only authenticated users can write.
    match /posts/{postId} {
      allow read: if isPublished(resource.data) || isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();

      match /revisions/{revisionId} {
        allow read, write: if isSignedIn();
      }
    }

    // Media library metadata.
    match /media/{mediaId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Categories & tags are public reference data, editable only when signed in.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /tags/{tagId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
