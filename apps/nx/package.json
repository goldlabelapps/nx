{
  "name": "nx",
  "version": "3.2.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -p 4500",
    "update:og-json": "node public/jpg/update-manifest.js",
    "prebuild": "cd ../.. && pnpm exec turbo run build --filter=nx^...",
    "build": "next build --webpack",
    "start": "next start -p 4500",
    "lint": "eslint",
    "pretypecheck": "cd ../.. && pnpm exec turbo run build --filter=nx^...",
    "pretype-check": "cd ../.. && pnpm exec turbo run build --filter=nx^...",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@goldlabelapps/agent-layer": "workspace:*",
    "@goldlabelapps/flash": "workspace:*",
    "@goldlabelapps/notify": "workspace:*",
    "@goldlabelapps/saas": "workspace:*",
    "@goldlabelapps/theme": "workspace:*",
    "@goldlabelapps/uberedux": "workspace:*",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "firebase": "^12.16.0",
    "firebase-admin": "^13.10.0",
    "gsap": "^3.12.5",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "next-pwa": "^5.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-redux": "^9.2.0",
    "react-share": "^5.3.0",
    "resend": "^6.17.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
