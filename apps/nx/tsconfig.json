{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@goldlabelapps/theme": ["../../packages/theme/src"],
      "@goldlabelapps/theme/*": ["../../packages/theme/src/*"],
      "@goldlabelapps/notify": ["../../packages/notify/src"],
      "@goldlabelapps/notify/*": ["../../packages/notify/src/*"],
      "@goldlabelapps/agent-layer": ["./node_modules/@goldlabelapps/agent-layer/dist/src"],
      "@goldlabelapps/agent-layer/*": ["./node_modules/@goldlabelapps/agent-layer/dist/src/*"],
      "@goldlabelapps/saas": ["../../packages/saas/src"],
      "@goldlabelapps/saas/*": ["../../packages/saas/src/*"],
      "@goldlabelapps/prospects": ["./node_modules/@goldlabelapps/prospects/dist/prospects/src"],
      "@goldlabelapps/prospects/*": ["./node_modules/@goldlabelapps/prospects/dist/prospects/src/*"],
      "prospects": ["./node_modules/@goldlabelapps/prospects/dist/prospects/src"],
      "prospects/*": ["./node_modules/@goldlabelapps/prospects/dist/prospects/src/*"],
      "@goldlabelapps/uberedux": ["./node_modules/@goldlabelapps/uberedux/dist"],
      "@goldlabelapps/uberedux/*": ["./node_modules/@goldlabelapps/uberedux/dist/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
